{
  "name": "eidoscope",
  "version": "0.0.1",
  "description": "An instrument for seeing the forms in a corpus — turn documents into interpretable cards on data-discovered axes, then look at their shape from every angle at once.",
  "type": "module",
  "license": "MIT",
  "author": "deepfates (with Claude)",
  "scripts": {
    "check:card": "bun run src/check-card.ts",
    "start": "bun run src/cli.ts",
    "fixture": "bun run src/cli.ts --fixture",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:redundancy": "bun run src/redundancy.ts"
  },
  "dependencies": {
    "@ax-llm/ax": "^23.0.5",
    "@huggingface/transformers": "3.8.1",
    "hnsw": "^1.1.1",
    "ml-kmeans": "^6.0.0",
    "ml-pca": "^4.1.1",
    "sharp": "0.35.3",
    "umap-js": "^1.4.0"
  },
  "bin": {
    "eidoscope": "./src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepfates/eidoscope.git"
  },
  "homepage": "https://github.com/deepfates/eidoscope#readme",
  "bugs": "https://github.com/deepfates/eidoscope/issues",
  "keywords": [
    "embeddings",
    "corpus",
    "cartography",
    "visualization",
    "llm",
    "concept-bottleneck",
    "semantic-map",
    "interpretability",
    "ax",
    "dspy",
    "readwise"
  ],
  "engines": {
    "bun": ">=1.0"
  }
}
